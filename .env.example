# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# --- LLM providers (at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models ---
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Vector store (Qdrant via docker compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hybrid_rag

# --- Corpus (point at your local docs; the private corpus is NEVER committed) ---
# Public/demo mode -> data/sample ; private daily-use mode -> your own folder.
# Example: an Obsidian vault (forward slashes work on Windows too):
#   CORPUS_DIR=C:/Users/you/Desktop/Travaux_AT/Memory_Obsidian/Etude_Trafic_AT
CORPUS_DIR=data/sample

# --- Chunking ---
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
TOP_K_DENSE=20
TOP_K_SPARSE=20
RRF_K=60
USE_RERANKER=true
TOP_K_RERANK=5
